# YouTube Search Skill - 环境变量示例
# 复制此文件为 .env 并填入实际值

# YouTube Data API v3 API密钥（必需）
# 获取地址: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-api-key-here

# 可选环境变量
# YT_SEARCH_DEBUG=true           # 启用调试模式
# YT_SEARCH_LOG_LEVEL=debug     # 设置日志级别
# YT_SEARCH_CACHE_TTL=7200      # 覆盖缓存时间（秒）
